# Configuración real con secretos
/config/config.php

# Logs y storage (se conserva la carpeta, se ignoran los logs)
/storage/*
!/storage/.gitkeep

# Dependencias (descomentar la siguiente línea si vas a versionar vendor/ por hosting sin Composer)
/vendor/

# Build de deploy (se regenera con build-deploy.sh)
/dist/

# Config del deploy en servidor (rutas/credenciales del host)
/deploy/deploy.config.sh

# Sistema
.DS_Store
Thumbs.db
*.swp

# Tests
application/.phpunit.cache/
mobile/coverage/

# Build de assets de la plataforma (los archivos generados en
# application/public/assets/vendor/ SÍ se versionan: el hosting no corre build).
application/node_modules/
