{
    "name": "satrak/plataforma-tracking",
    "description": "Satrak — Plataforma web multi-empresa de seguimiento satelital de vehículos y personal.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*",
        "ext-mbstring": "*",
        "ext-json": "*",
        "slim/slim": "^4.12",
        "slim/psr7": "^1.6",
        "slim/twig-view": "^3.3",
        "php-di/php-di": "^7.0",
        "phpmailer/phpmailer": "^6.9"
    },
    "autoload": {
        "psr-4": {
            "Satrak\\": "src/"
        },
        "files": [
            "src/Application/Support/helpers.php"
        ]
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "scripts": {
        "processor": "php bin/processor.php",
        "purge": "php bin/purge.php",
        "seed": "php bin/seed_mock.php"
    }
}
