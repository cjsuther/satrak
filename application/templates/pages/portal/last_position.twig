{% extends "layouts/app.twig" %}
{% block title %}Mi última posición{% endblock %}

{% block head %}
  <link rel="stylesheet" href="{{ asset('/assets/vendor/maplibre-gl.css') }}">
{% endblock %}

{% block content %}
<div class="page-head">
  <div><span class="eyebrow">Portal del conductor</span><h1>Mi última posición</h1></div>
  <a class="btn btn-secondary" href="/portal/actividad">Mi actividad</a>
</div>

{% if pos %}
  <div class="card kpi-strip">
    <div><span class="kpi-label">Vehículo</span><span class="mono">{{ pos.plate ?? 'sin vehículo' }}</span></div>
    <div><span class="kpi-label">Velocidad</span><span class="mono">{{ pos.speed ?? 0 }} km/h</span></div>
    <div><span class="kpi-label">Ignición</span><span class="mono">{{ pos.ignition ? 'ON' : 'OFF' }}</span></div>
    <div><span class="kpi-label">Actualizado</span><span class="mono">{{ pos.ts|date('d/m H:i:s') }}</span></div>
  </div>

  <div class="card map-canvas" style="min-height:440px;padding:0;overflow:hidden">
    <div id="map" class="vector-map"
         data-mode="point"
         data-lat="{{ pos.lat }}" data-lon="{{ pos.lon }}"
         data-label="{{ (pos.plate ?? 'Mi unidad') ~ ' · ' ~ (pos.speed ?? 0) ~ ' km/h' }}"></div>
  </div>
{% else %}
  <div class="card"><p class="muted">Todavía no hay posiciones registradas a tu nombre.</p></div>
{% endif %}
{% endblock %}

{% block scripts %}
{% if pos %}
  <script src="{{ asset('/assets/vendor/maplibre-gl.js') }}"></script>
  <script src="{{ asset('/assets/js/zonemap.js') }}"></script>
  <script src="{{ asset('/assets/js/map.js') }}" defer></script>
{% endif %}
{% endblock %}
