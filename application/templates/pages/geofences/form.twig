{% extends "layouts/app.twig" %}
{% block title %}{{ mode == 'create' ? 'Nueva geocerca' : 'Editar geocerca' }}{% endblock %}

{% block head %}
  <link rel="stylesheet" href="{{ asset('/assets/vendor/maplibre-gl.css') }}">
{% endblock %}

{% block content %}
<div class="page-head">
  <div><span class="eyebrow"><a href="/geocercas">Geocercas</a> / {{ mode == 'create' ? 'nueva' : 'editar' }}</span>
  <h1>{{ mode == 'create' ? 'Nueva geocerca' : g.name }}</h1></div>
</div>

<form method="post" action="{{ mode == 'create' ? '/geocercas' : '/geocercas/' ~ g.id }}" class="card form-card" novalidate
      data-geofence-form>
  {{ csrf_field() }}
  <input type="hidden" name="shape" value="{{ g.shape }}" data-shape>
  <input type="hidden" name="geometry" value='{{ g.geometry|default("") }}' data-geometry>
  {# Contrato nuevo: la zona también viaja como FeatureCollection de GeoJSON.
     El backend valida y convierte; `geometry` se mantiene por compatibilidad. #}
  <input type="hidden" name="zones" value="" data-zones>

  <div class="form-grid">
    <label class="field">
      <span class="field-label">Nombre *</span>
      <input class="input" name="name" value="{{ g.name|default('') }}" required autofocus>
      {% if errors.name is defined %}<small class="field-error">{{ errors.name }}</small>{% endif %}
    </label>

    {% if mode == 'edit' %}
      <label class="field">
        <span class="field-label">Estado</span>
        <select class="input" name="active">
          <option value="1" {{ g.active ? 'selected' }}>Activa</option>
          <option value="0" {{ not g.active ? 'selected' }}>Inactiva</option>
        </select>
      </label>
    {% endif %}
  </div>

  <div class="geofence-editor">
    <div class="geofence-tools" role="group" aria-label="Herramientas de dibujo">
      <button type="button" class="draw-tool" data-mode="polygon"   aria-pressed="true">Polígono</button>
      <button type="button" class="draw-tool" data-mode="freehand"  aria-pressed="false">Mano alzada</button>
      <button type="button" class="draw-tool" data-mode="circle"    aria-pressed="false">Círculo</button>
      <button type="button" class="draw-tool" data-mode="rectangle" aria-pressed="false">Rectángulo</button>
      <button type="button" class="draw-tool" data-mode="select"    aria-pressed="false">Seleccionar</button>
      <button type="button" class="btn btn-secondary btn-sm" data-clear>Limpiar</button>
    </div>
    <p class="muted geofence-hint" data-draw-hint>Hacé clic para marcar cada vértice. Doble clic para cerrar.</p>
    <div id="geofence-map" class="vector-map geofence-map"></div>
    {% if errors.geometry is defined %}<small class="field-error">{{ errors.geometry }}</small>{% endif %}
  </div>

  {% if can('fleet.manage') %}
    <fieldset class="field" style="border:0;padding:0;margin-top:var(--space-5)">
      <span class="field-label">Alcance (vehículos)</span>
      <p class="muted" style="font-size:var(--fs-mono);margin:.2rem 0 .6rem">Sin seleccionar = aplica a todos los vehículos.</p>
      <div class="checkbox-grid">
        {% for v in vehicles %}
          <label class="checkbox-pill">
            <input type="checkbox" name="vehicle_ids[]" value="{{ v.id }}" {{ v.id in selectedIds ? 'checked' }}>
            <span class="mono">{{ v.plate }}</span>
          </label>
        {% else %}
          <span class="muted">No hay vehículos activos.</span>
        {% endfor %}
      </div>
    </fieldset>
  {% endif %}

  {% if can('people.monitor') %}
    <fieldset class="field" style="border:0;padding:0;margin-top:var(--space-5)">
      <span class="field-label">Alcance (personas)</span>
      <p class="muted" style="font-size:var(--fs-mono);margin:.2rem 0 .6rem">Sin seleccionar = aplica a todas las personas.</p>
      <div class="checkbox-grid">
        {% for p in people %}
          <label class="checkbox-pill">
            <input type="checkbox" name="person_ids[]" value="{{ p.id }}" {{ p.id in selectedPeopleIds ? 'checked' }}>
            <span>{{ p.first_name }} {{ p.last_name }}</span>
          </label>
        {% else %}
          <span class="muted">No hay personas activas.</span>
        {% endfor %}
      </div>
    </fieldset>
  {% endif %}

  <div class="form-actions">
    <a class="btn btn-secondary" href="/geocercas">Cancelar</a>
    <button class="btn btn-primary" type="submit">{{ mode == 'create' ? 'Crear geocerca' : 'Guardar cambios' }}</button>
  </div>
</form>
{% endblock %}

{% block scripts %}
  <script src="{{ asset('/assets/vendor/maplibre-gl.js') }}"></script>
  <script src="{{ asset('/assets/vendor/terra-draw.js') }}"></script>
  <script src="{{ asset('/assets/js/zonemap.js') }}"></script>
  <script src="{{ asset('/assets/js/geofence.js') }}" defer></script>
{% endblock %}
