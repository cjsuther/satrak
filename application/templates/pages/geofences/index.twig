{% extends "layouts/app.twig" %}
{% block title %}Geocercas{% endblock %}

{% block content %}
<div class="page-head">
  <div><span class="eyebrow">Monitoreo</span><h1>Geocercas</h1></div>
  <a class="btn btn-primary" href="/geocercas/nueva">+ Nueva geocerca</a>
</div>

<div class="card">
  <table class="data-table">
    <thead><tr><th>Nombre</th><th>Forma</th><th>Alcance</th><th>Estado</th><th class="ta-right">Acciones</th></tr></thead>
    <tbody>
      {% for g in geofences %}
        <tr>
          <td><strong>{{ g.name }}</strong></td>
          <td>{{ g.shape == 'circle' ? 'Círculo' : 'Polígono' }}</td>
          <td class="muted">
            {{ g.vehicle_count > 0 ? g.vehicle_count ~ ' vehículo(s)' : 'todos los vehículos' }}
            ·
            {{ g.person_count > 0 ? g.person_count ~ ' persona(s)' : 'todas las personas' }}
          </td>
          <td>
            <span class="badge {{ g.active ? 'badge-ok' : 'badge-off' }}"><span class="dot"></span>{{ g.active ? 'activa' : 'inactiva' }}</span>
          </td>
          <td class="ta-right actions">
            <a class="btn btn-secondary btn-sm" href="/geocercas/{{ g.id }}/editar">Editar</a>
            <form method="post" action="/geocercas/{{ g.id }}/eliminar" class="inline-form"
                  data-confirm="¿Eliminar la geocerca «{{ g.name }}»?">
              {{ csrf_field() }}
              <button class="btn btn-secondary btn-sm" type="submit">Eliminar</button>
            </form>
          </td>
        </tr>
      {% else %}
        <tr><td colspan="5" class="muted">No hay geocercas todavía.</td></tr>
      {% endfor %}
    </tbody>
  </table>
</div>
{% endblock %}
