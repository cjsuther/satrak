{% extends "layouts/app.twig" %}
{% block title %}Mapa en vivo{% endblock %}

{% block head %}
  <link rel="stylesheet" href="{{ asset('/assets/vendor/maplibre-gl.css') }}">
{% endblock %}

{% block content %}
<div class="page-head">
  <div>
    <span class="eyebrow">Monitoreo</span><h1>Mapa en vivo</h1>
  </div>
  <div class="map-sync readout">
    <span class="live-dot" aria-hidden="true"></span>
    <span data-sync-label>conectando…</span>
  </div>
</div>

<div class="map-layout card">
  <aside class="map-panel">
    <div class="map-panel-head">
      <input type="search" class="input" placeholder="Buscar patente / persona…" data-unit-search aria-label="Buscar unidad">
      {% if can('monitoring.view') and can('people.monitor') %}
        <div class="map-filters" role="group" aria-label="Filtrar por tipo de unidad">
          <button type="button" class="chip is-active" data-kind-filter="all">Todas</button>
          <button type="button" class="chip" data-kind-filter="vehicle">Vehículos</button>
          <button type="button" class="chip" data-kind-filter="person">Personas</button>
        </div>
      {% endif %}
      <div class="map-filters" role="group" aria-label="Filtrar por estado">
        <button type="button" class="chip is-active" data-filter="all">Todos los estados</button>
        <button type="button" class="chip" data-filter="movimiento">En movimiento</button>
        <button type="button" class="chip" data-filter="detenido">Detenidas</button>
        {% if can('people.monitor') %}
          <button type="button" class="chip" data-filter="fuera_de_puesto">Fuera de puesto</button>
        {% endif %}
        <button type="button" class="chip" data-filter="offline">Sin señal</button>
      </div>
    </div>
    <ul class="unit-list" data-unit-list>
      <li class="unit-empty muted">Cargando unidades…</li>
    </ul>
  </aside>

  <div class="map-canvas">
    <div id="map" class="vector-map"
         data-mode="live"
         data-endpoint="/api/live/positions"
         data-poll="{{ poll_seconds }}"></div>
  </div>
</div>
{% endblock %}

{% block scripts %}
  <script src="{{ asset('/assets/vendor/maplibre-gl.js') }}"></script>
  <script src="{{ asset('/assets/js/zonemap.js') }}"></script>
  <script src="{{ asset('/assets/js/map.js') }}" defer></script>
{% endblock %}
