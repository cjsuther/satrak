{% extends "layouts/app.twig" %}
{% block title %}Historial{% endblock %}

{% block head %}
  <link rel="stylesheet" href="{{ asset('/assets/vendor/maplibre-gl.css') }}">
{% endblock %}

{% block content %}
<div class="page-head">
  <div>
    <span class="eyebrow">Monitoreo</span><h1>Historial y reproducción</h1>
  </div>
</div>

<form method="get" action="/historial" class="card filter-bar">
  <label class="field">
    <span>Dispositivo / vehículo</span>
    <select name="device_id" class="input" required>
      <option value="">Elegí una unidad…</option>
      {% set vehicles = devices|filter(d => d.kind != 'person') %}
      {% set persons  = devices|filter(d => d.kind == 'person') %}
      {% if vehicles is not empty %}
        <optgroup label="Vehículos">
          {% for d in vehicles %}
            <option value="{{ d.id }}" {{ d.id == device_id ? 'selected' : '' }}>
              {{ d.plate ? d.plate : (d.label ?? d.imei) }}{{ d.plate and d.label ? ' · ' ~ d.label : '' }}
            </option>
          {% endfor %}
        </optgroup>
      {% endif %}
      {% if persons is not empty %}
        <optgroup label="Personas">
          {% for d in persons %}
            <option value="{{ d.id }}" {{ d.id == device_id ? 'selected' : '' }}>
              {{ d.person_name ?: (d.label ?? d.imei) }}
            </option>
          {% endfor %}
        </optgroup>
      {% endif %}
    </select>
  </label>
  <label class="field">
    <span>Desde</span>
    <input type="datetime-local" name="from" class="input" value="{{ from|date('Y-m-d\\TH:i') }}">
  </label>
  <label class="field">
    <span>Hasta</span>
    <input type="datetime-local" name="to" class="input" value="{{ to|date('Y-m-d\\TH:i') }}">
  </label>
  <button type="submit" class="btn btn-primary">Ver recorrido</button>
</form>

{% if has_device %}
  <div class="map-layout card">
    <aside class="map-panel">
      <div class="map-panel-head">
        <h2 class="panel-title">Viajes del período <span class="mono muted">({{ trips|length }})</span></h2>
      </div>
      <ul class="trip-list" data-trip-list>
        {% for t in trips %}
          <li class="trip-item" data-trip
              data-from="{{ t.started_at }}" data-to="{{ t.ended_at ?? to }}">
            <div class="trip-item-head">
              <span class="trip-driver">{{ (t.first_name or t.last_name) ? (t.first_name ~ ' ' ~ t.last_name)|trim : 'No identificado' }}</span>
              <span class="badge {{ t.ended_at ? 'badge-off' : 'badge-ok' }}"><span class="dot"></span>{{ t.ended_at ? 'cerrado' : 'en curso' }}</span>
            </div>
            <div class="trip-item-meta mono muted">
              {{ t.started_at|date('d/m H:i') }} → {{ t.ended_at ? t.ended_at|date('H:i') : '—' }}
              · {{ t.distance_km ?? 0 }} km
              · {{ ((t.duration_sec ?? 0) // 60) }} min
              · máx {{ t.max_speed ?? 0 }} km/h
            </div>
          </li>
        {% else %}
          <li class="unit-empty muted">No hay viajes en este período.</li>
        {% endfor %}
      </ul>
    </aside>

    <div class="map-canvas">
      <div id="map" class="vector-map"
           data-mode="history"
           data-device="{{ device_id }}"
           data-from="{{ from }}"
           data-to="{{ to }}"></div>

      <div class="replay-bar" data-replay hidden>
        <button type="button" class="btn btn-secondary btn-sm" data-replay-toggle aria-label="Reproducir">▶</button>
        <input type="range" class="replay-scrub" min="0" max="100" value="0" step="1" data-replay-scrub aria-label="Posición">
        <div class="replay-speeds" role="group" aria-label="Velocidad de reproducción">
          <button type="button" class="chip is-active" data-speed="1">1×</button>
          <button type="button" class="chip" data-speed="2">2×</button>
          <button type="button" class="chip" data-speed="4">4×</button>
        </div>
        <span class="replay-readout mono" data-replay-readout>—</span>
      </div>
    </div>
  </div>
{% else %}
  <div class="card">
    <p class="muted">Elegí una unidad y un rango para ver el recorrido y reproducirlo.</p>
  </div>
{% endif %}
{% endblock %}

{% block scripts %}
  <script src="{{ asset('/assets/vendor/maplibre-gl.js') }}"></script>
  <script src="{{ asset('/assets/js/zonemap.js') }}"></script>
  <script src="{{ asset('/assets/js/map.js') }}" defer></script>
{% endblock %}
