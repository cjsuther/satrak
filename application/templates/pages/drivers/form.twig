{% extends "layouts/app.twig" %}
{% block title %}{{ mode == 'create' ? 'Nuevo conductor' : 'Editar conductor' }}{% endblock %}

{% block content %}
<div class="page-head">
  <div><span class="eyebrow"><a href="/conductores">Conductores</a> / {{ mode == 'create' ? 'nuevo' : 'editar' }}</span>
  <h1>{{ mode == 'create' ? 'Nuevo conductor' : d.first_name ~ ' ' ~ d.last_name }}</h1></div>
</div>

<form method="post" action="{{ mode == 'create' ? '/conductores' : '/conductores/' ~ d.id }}" class="card form-card" novalidate>
  {{ csrf_field() }}
  <div class="form-grid">
    <label class="field">
      <span class="field-label">Nombre *</span>
      <input class="input" name="first_name" value="{{ d.first_name|default('') }}" required autofocus>
      {% if errors.first_name is defined %}<small class="field-error">{{ errors.first_name }}</small>{% endif %}
    </label>
    <label class="field">
      <span class="field-label">Apellido *</span>
      <input class="input" name="last_name" value="{{ d.last_name|default('') }}" required>
      {% if errors.last_name is defined %}<small class="field-error">{{ errors.last_name }}</small>{% endif %}
    </label>
    <label class="field">
      <span class="field-label">DNI</span>
      <input class="input mono" name="dni" value="{{ d.dni|default('') }}">
    </label>
    <label class="field">
      <span class="field-label">Licencia</span>
      <input class="input mono" name="license_number" value="{{ d.license_number|default('') }}">
    </label>
    <label class="field">
      <span class="field-label">Teléfono</span>
      <input class="input mono" name="phone" value="{{ d.phone|default('') }}">
    </label>
    <label class="field">
      <span class="field-label">Email</span>
      <input class="input" type="email" name="email" value="{{ d.email|default('') }}">
      {% if errors.email is defined %}<small class="field-error">{{ errors.email }}</small>{% endif %}
    </label>
    <label class="field">
      <span class="field-label">PIN ({{ pin_min }}–{{ pin_max }}, alfanumérico, único)</span>
      <input class="input mono" name="pin" value="{{ d.pin|default('') }}" maxlength="{{ pin_max }}" autocomplete="off">
      {% if errors.pin is defined %}<small class="field-error">{{ errors.pin }}</small>{% endif %}
    </label>
    {% if mode == 'edit' %}
      <label class="field">
        <span class="field-label">Estado</span>
        <select class="input" name="status">
          <option value="active" {{ d.status == 'active' ? 'selected' }}>Activo</option>
          <option value="inactive" {{ d.status == 'inactive' ? 'selected' }}>Inactivo</option>
        </select>
      </label>
    {% endif %}
  </div>

  <div class="form-actions">
    <a class="btn btn-secondary" href="/conductores">Cancelar</a>
    <button class="btn btn-primary" type="submit">{{ mode == 'create' ? 'Crear conductor' : 'Guardar cambios' }}</button>
  </div>
</form>
{% endblock %}
