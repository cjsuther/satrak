{% extends "layouts/app.twig" %}
{% block title %}Usuarios{% endblock %}

{% block content %}
<div class="page-head">
  <div>
    <span class="eyebrow">Gestión</span>
    <h1>Usuarios</h1>
  </div>
</div>

<div class="card">
  <table class="data-table">
    <thead>
      <tr>
        <th>Nombre</th><th>Email</th><th>Rol</th><th>Estado</th><th>Último acceso</th>
      </tr>
    </thead>
    <tbody>
      {% for u in users %}
        <tr>
          <td><a href="/usuarios/{{ u.id }}">{{ u.name }}</a></td>
          <td class="mono">{{ u.email }}</td>
          <td><span class="tag">{{ u.role }}</span></td>
          <td>
            <span class="badge {{ u.status == 'active' ? 'badge-ok' : 'badge-off' }}">
              <span class="dot"></span> {{ u.status }}
            </span>
          </td>
          <td class="mono muted">{{ u.last_login_at ?? '—' }}</td>
        </tr>
      {% else %}
        <tr><td colspan="5" class="muted">No hay usuarios todavía.</td></tr>
      {% endfor %}
    </tbody>
  </table>
</div>
<p class="muted" style="margin-top:var(--space-4)">
  Vista de solo lectura (Fase 2). El alta/edición de usuarios llega en la Fase 3.
</p>
{% endblock %}
