{% extends "layouts/app.twig" %}
{% block title %}Mi ubicación{% endblock %}

{% block head %}
  <link rel="stylesheet" href="{{ asset('/assets/vendor/maplibre-gl.css') }}">
{% endblock %}

{% block content %}
<div class="page-head">
  <div>
    <span class="eyebrow">Mi portal</span><h1>Mi última ubicación</h1>
    <p class="muted">
      {% if on_shift %}Estás en jornada: tu ubicación se está registrando.
      {% else %}Estás fuera de jornada: tu ubicación no se registra.{% endif %}
    </p>
  </div>
</div>

<div class="card">
  {% if pos %}
    <p class="mono muted">{{ pos.ts }}
      {%- if pos.battery_pct is not null %} · batería {{ pos.battery_pct }}%{% endif %}</p>
    <div id="map" class="vector-map"
         data-mode="point"
         data-lat="{{ pos.lat }}"
         data-lon="{{ pos.lon }}"
         data-label="Mi última posición · {{ pos.ts }}"></div>
  {% else %}
    <p class="muted">Todavía no hay ubicaciones registradas para vos.</p>
  {% endif %}
</div>
{% endblock %}

{% block scripts %}
  {% if pos %}
  <script src="{{ asset('/assets/vendor/maplibre-gl.js') }}"></script>
  <script src="{{ asset('/assets/js/zonemap.js') }}"></script>
    <script src="{{ asset('/assets/js/map.js') }}" defer></script>
  {% endif %}
{% endblock %}
