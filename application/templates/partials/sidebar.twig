{# Barra lateral. Ítems visibles según permisos del rol (can()). #}
<aside class="sidebar">
  <div class="sidebar-brand">
    <span class="brand">satrak<span class="dot">.</span></span>
  </div>

  <nav class="sidebar-nav" aria-label="Navegación principal">
    {% if can('driver.portal') %}
      {# Portal del conductor: navegación acotada a lo propio. #}
      <span class="nav-section">Mi portal</span>
      <a class="nav-item {{ current_path starts with '/portal/actividad' or current_path == '/portal' ? 'is-active' : '' }}" href="/portal/actividad"><span class="nav-ico">↻</span> Mi actividad</a>
      <a class="nav-item {{ current_path starts with '/portal/ubicacion' ? 'is-active' : '' }}" href="/portal/ubicacion"><span class="nav-ico">◈</span> Mi última posición</a>
      <a class="nav-item {{ current_path starts with '/portal/perfil' ? 'is-active' : '' }}" href="/portal/perfil"><span class="nav-ico">☉</span> Mi perfil</a>
    {% else %}
    <a class="nav-item {{ current_path == '/dashboard' ? 'is-active' : '' }}" href="/dashboard">
      <span class="nav-ico">◎</span> Dashboard
    </a>

    {% if can('companies.manage') %}
      <a class="nav-item {{ current_path starts with '/empresas' ? 'is-active' : '' }}" href="/empresas">
        <span class="nav-ico">▣</span> Empresas
      </a>
    {% endif %}

    {% if can('monitoring.view') %}
      <span class="nav-section">Monitoreo</span>
      <a class="nav-item {{ current_path == '/mapa' ? 'is-active' : '' }}" href="/mapa"><span class="nav-ico">◈</span> Mapa en vivo</a>
      <a class="nav-item {{ current_path starts with '/historial' ? 'is-active' : '' }}" href="/historial"><span class="nav-ico">↻</span> Historial</a>
    {% endif %}

    {% if can('alerts.ack') %}
      <a class="nav-item {{ current_path starts with '/alertas' ? 'is-active' : '' }}" href="/alertas"><span class="nav-ico">△</span> Alertas</a>
    {% endif %}

    {% if can('geofences.manage') %}
      <a class="nav-item {{ current_path starts with '/geocercas' ? 'is-active' : '' }}" href="/geocercas"><span class="nav-ico">⬡</span> Geocercas</a>
      <a class="nav-item {{ current_path starts with '/reglas-alerta' ? 'is-active' : '' }}" href="/reglas-alerta"><span class="nav-ico">◬</span> Reglas de alerta</a>
    {% endif %}

    {% if can('reports.view') %}
      <a class="nav-item {{ current_path starts with '/reportes' ? 'is-active' : '' }}" href="/reportes"><span class="nav-ico">▤</span> Reportes</a>
    {% endif %}

    {% if can('fleet.manage') or can('users.manage') %}
      <span class="nav-section">Gestión</span>
      {% if can('fleet.manage') %}
        <a class="nav-item {{ current_path starts with '/vehiculos' ? 'is-active' : '' }}" href="/vehiculos"><span class="nav-ico">⛟</span> Vehículos</a>
        <a class="nav-item {{ current_path starts with '/dispositivos' ? 'is-active' : '' }}" href="/dispositivos"><span class="nav-ico">▦</span> Dispositivos</a>
        <a class="nav-item {{ current_path starts with '/conductores' ? 'is-active' : '' }}" href="/conductores"><span class="nav-ico">☉</span> Conductores</a>
      {% endif %}
      {% if can('users.manage') %}
        <a class="nav-item {{ current_path starts with '/usuarios' ? 'is-active' : '' }}" href="/usuarios">
          <span class="nav-ico">☰</span> Usuarios
        </a>
      {% endif %}
    {% endif %}

    {% if can('audit.global') or can('audit.company') %}
      <a class="nav-item" href="#" data-soon><span class="nav-ico">❘</span> Auditoría</a>
    {% endif %}
    {% endif %}{# /driver.portal else #}
  </nav>

  <div class="sidebar-foot mono">v1 · {{ app.env }}</div>
</aside>
<label for="nav-toggle" class="nav-scrim" aria-hidden="true"></label>
