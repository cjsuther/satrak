# Satrak — front controller + seguridad (Apache / Hostinger)

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Forzar HTTPS (Hostinger termina TLS; respeta el header del proxy).
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Servir archivos/carpetas reales tal cual (assets).
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Todo lo demás al front controller.
    RewriteRule ^ index.php [QSA,L]
</IfModule>

# No listar directorios.
Options -Indexes

# Cabeceras de seguridad.
#
# La CSP se declara ACÁ y no sólo en PHP: el servidor de Hostinger inyecta su
# propia `Content-Security-Policy: upgrade-insecure-requests` y PISA la que
# emite la aplicación. Verificado en producción el 2026-08-28: la CSP de
# index.php no llegaba al navegador y el sitio quedaba sin defensa contra XSS.
# Si se toca la CSP de PHP, hay que tocar esta también.
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "microphone=(), camera=(), payment=(), usb=()"

    # HSTS: dos años, subdominios incluidos. El sitio ya redirige todo a HTTPS.
    Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains"

    Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data: https://*.tile.openstreetmap.org https://unpkg.com; style-src 'self' 'unsafe-inline' https://unpkg.com https://fonts.googleapis.com; script-src 'self' https://unpkg.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests"
</IfModule>

# Bloquear acceso a archivos sensibles si quedaran dentro de public por error.
<FilesMatch "\.(php~|bak|inc|sql|md|log|ini)$">
    Require all denied
</FilesMatch>
