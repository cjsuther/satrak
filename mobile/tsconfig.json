{
  "compilerOptions": {
    // ES2015 es el techo: en Android 5/6 el System WebView puede ser viejo.
    "target": "ES2015",
    "lib": ["ES2017", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true
  },
  "include": ["src", "capacitor.config.ts", "vite.config.ts"],
  "exclude": [".testbuild", "dist", "node_modules"]
}
